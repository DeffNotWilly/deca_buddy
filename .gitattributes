# Normalise line endings so the site behaves the same on every machine.
# GitHub Pages serves these files straight from the repo, so LF everywhere.
* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf

# keep them as real files, not symlinks
*.png binary
*.jpg binary
*.ico binary
